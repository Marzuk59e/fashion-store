# ─── Firebase (required) ──────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Admin Panel (required) ───────────────────────────────────────────────────
# Set any strong secret string. This is the password for the admin panel login.
VITE_ADMIN_SECRET_KEY=your-strong-secret-here

# ─── OTP Email — Vercel (required for email sign-up) ─────────────────────────
# Set these in: Vercel → Project → Settings → Environment Variables
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# OTP_HASH_SECRET=long-random-string
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-gmail-app-password
# OTP_FROM_EMAIL=your@gmail.com
# OTP_FROM_NAME=Your Store Name

# ─── OTP Endpoints (optional override) ───────────────────────────────────────
# Only needed if you self-host the OTP API outside Vercel.
# Leave blank if deploying to Vercel — it uses /api/* automatically.
VITE_OTP_SEND_ENDPOINT=
VITE_OTP_VERIFY_ENDPOINT=
